# Copy this file to .env, then paste your Klaviyo private API key below.
#   cp .env.example .env
#
# Get a key in Klaviyo: Settings > API Keys > Create Private API Key.
# Start with read-only scopes. Add write scopes later, when you want Claude
# to build segments, edit drafts, or schedule campaigns.
#
# .env is gitignored, so the key never leaves your machine.
KLAVIYO_API_KEY=pk_your_key_here
